{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run check:learning-contract && npm run check:learning-migrations && npm run check:routing-artifact && vitest run && node --test scripts/learning-hourly.check.mjs",
    "test:watch": "vitest",
    "check:learning-contract": "node scripts/check-musicdna-learning-contract.mjs && node scripts/check-musicdna-deletion-contract.mjs && node scripts/check-musicdna-real-qa-contract.mjs",
    "check:learning-migrations": "node scripts/check-musicdna-lifecycle-migration.mjs",
    "test:learning-outbox": "node scripts/require-learning-outbox-db.mjs && vitest run src/musicdna/learning/outbox-db.test.ts src/musicdna/learning/dispatcher-db.test.ts src/musicdna/learning/real-qa-db.test.ts src/musicdna/learning/worker-status-db.test.ts",
    "build:learning-worker": "vite build --config vite.learning-worker.config.ts",
    "learning:worker": "node dist-learning-worker/worker.mjs",
    "verify:learning-journey": "node --experimental-strip-types tools/musicdna/verify-learning-acceptance.ts",
    "check:routing-artifact": "node scripts/check-routing-artifact.mjs",
    "test:applied-outcomes": "node scripts/require-learning-outbox-db.mjs && vitest run src/musicdna/learning/applied-routing.test.ts src/musicdna/learning/applied-outcomes-db.test.ts",
    "test:pilot": "node scripts/require-learning-outbox-db.mjs && vitest run src/musicdna/learning/pilot-routing.test.ts src/musicdna/learning/pilot-db.test.ts",
    "build:learning-edge": "vite build --config vite.learning-edge.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.110.5",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@tanstack/router-plugin": "1.168.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.26.5",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "postgres": "4.1.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
