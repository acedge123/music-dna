FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY scripts/ scripts/
COPY src/musicdna/ src/musicdna/
COPY vite.learning-worker.config.ts tsconfig.json ./
RUN npm run build:learning-worker && npm prune --omit=dev
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist-learning-worker ./dist-learning-worker
COPY scripts/learning-hourly.mjs ./scripts/learning-hourly.mjs
COPY package.json ./package.json
USER node
CMD ["node","scripts/learning-hourly.mjs"]
