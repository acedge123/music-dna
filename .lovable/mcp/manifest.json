      {
        "name": "song_whys_export",
        "title": "song whys export",
        "description": "Use this when start or advance an asynchronous complete JSON/CSV export. Start requires a fresh idempotency key. Status advances the queued snapshot job. Ready links expire and require the SAME account and current catalog permission; no records are truncated inline.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "start",
                "status"
              ]
            },
            "mutation_id": {
              "type": "string",
              "format": "uuid"
            },
            "job_id": {
              "$ref": "#/properties/mutation_id"
            },
            "format": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            },
            "filters": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "pending_review",
                    "rejected"
