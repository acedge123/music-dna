                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "required": [
            "explanation_ids"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "song_whys_find_conflicts",
        "title": "song whys find conflicts",
        "description": "Use this when inspect complete explanations on the same song for potential opposing audible descriptions. Returns exact excerpts/IDs as hypotheses requiring listening, not proven contradictions.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
