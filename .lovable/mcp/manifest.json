      {
        "name": "song_whys_run_audit",
        "title": "song whys run audit",
        "description": "Use this when run independent rule-based text/catalog screening without changing content or calling an AI model. Hear claims always require listening; assistant must independently inspect returned evidence before suggesting wording.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "explanation_ids": {
              "type": "array",
