          "readOnlyHint": true,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "cursor": {
              "type": "string",
              "maxLength": 5000
            },
            "artist": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
