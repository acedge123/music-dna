      {
        "name": "search",
        "title": "Search MusicDNA catalog",
        "description": "Find catalog songs by title, artist or verified release title. Returns up to 20 identity matches; use catalog_search_songs for complete cursor pagination.",
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "fetch",
        "title": "Fetch MusicDNA catalog song",
        "description": "Read an exact song item returned by search, including canonical scores, associated explanations and provenance. This does not fetch private interview traces.",
