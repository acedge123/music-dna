      {
        "name": "song_whys_submit_revision",
        "title": "song whys submit revision",
        "description": "Use this when submit a version-bound draft to the existing human Admin Song Whys review queue. Requires explicit confirmation and an idempotency key. NEVER overwrites, approves or publishes the original.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "explanation_id": {
              "type": "string",
              "format": "uuid"
            },
            "base_version": {
              "type": "string",
              "pattern": "^why-v1:[0-9a-f]{64}$"
            },
            "hear": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "means": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "reason": {
              "type": "string",
              "minLength": 10,
              "maxLength": 2000
            },
            "supporting_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "catalog_fact",
                      "text_inference",
                      "requires_listening",
                      "verified_recording_source"
                    ]
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "kind",
                  "reference",
                  "note"
                ],
                "additionalProperties": false
              },
              "maxItems": 20
            },
            "mutation_id": {
              "$ref": "#/properties/explanation_id"
            },
            "confirm_submit": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "explanation_id",
            "base_version",
            "hear",
            "means",
            "reason",
            "supporting_evidence",
            "mutation_id",
            "confirm_submit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "song_whys_record_audit_findings",
        "title": "song whys record audit findings",
        "description": "Use this when explicitly save evidence-bound audit findings without changing explanation approval. Repeated unresolved findings deduplicate; an idempotency key prevents duplicate writes.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "explanation_id": {
              "type": "string",
              "format": "uuid"
            },
            "base_version": {
              "type": "string",
              "pattern": "^why-v1:[0-9a-f]{64}$"
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "excerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "suggested_wording": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "verification_kind": {
                    "type": "string",
                    "enum": [
                      "catalog_fact",
                      "text_inference",
                      "requires_listening"
                    ]
                  }
                },
                "required": [
                  "severity",
                  "category",
                  "excerpt",
                  "explanation",
                  "verification_kind"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 25
            },
            "mutation_id": {
              "$ref": "#/properties/explanation_id"
            },
            "confirm_submit": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "explanation_id",
            "base_version",
            "findings",
            "mutation_id",
            "confirm_submit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
